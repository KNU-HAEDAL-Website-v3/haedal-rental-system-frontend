    classDef ucSearch fill:#fff8e1,stroke:#f9a825,stroke-width:1px
    classDef ucRent fill:#fce4ec,stroke:#c2185b,stroke-width:1px
    classDef ucAdmin fill:#ede7f6,stroke:#5e35b1,stroke-width:1px

    GUEST["미승인회원"]:::actor
    MEMBER["활동회원"]:::actor
    ADMIN["운영진"]:::actor

    subgraph SYS["동아리 도서 관리 시스템"]
