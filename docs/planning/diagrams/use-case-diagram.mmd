        U09(["도서 상세 조회"]):::ucSearch

        U10(["도서 대여"]):::ucRent
        U11(["도서 반납"]):::ucRent
        U12(["대여 연장"]):::ucRent
        U13(["라벨 스캔"]):::ucRent
