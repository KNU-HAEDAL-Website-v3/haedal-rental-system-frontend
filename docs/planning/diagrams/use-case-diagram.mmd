        U02(["추가 정보 입력"]):::ucAuth
        U03(["가입 승인·반려"]):::ucAuth

        U04(["도서 등록"]):::ucBook
        U05(["도서 정보 수정"]):::ucBook
        U06(["라벨코드 발급"]):::ucBook

        U07(["도서 목록 조회"]):::ucSearch
